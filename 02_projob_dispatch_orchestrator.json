      ]
    },
    "Log Decision to Supabase": { "main": [[{ "node": "Mark Job Dispatched", "type": "main", "index": 0 }]] },
    "Mark Job Dispatched": { "main": [[{ "node": "Lookup Sub Phone", "type": "main", "index": 0 }]] },
    "Lookup Sub Phone": { "main": [[{ "node": "Send SMS via Twilio", "type": "main", "index": 0 }]] },
    "Send SMS via Twilio": { "main": [[{ "node": "Respond (Dispatched)", "type": "main", "index": 0 }]] },
    "Log Escalation": { "main": [[{ "node": "Mark Job Escalated", "type": "main", "index": 0 }]] },
    "Mark Job Escalated": { "main": [[{ "node": "Notify Oscar (Email)", "type": "main", "index": 0 }]] },
    "Notify Oscar (Email)": { "main": [[{ "node": "Respond (Escalated)", "type": "main", "index": 0 }]] }
  }
}
